# ---- Bright Data ISP zone (never commit real values) ----
BRD_USER=brd-customer-hl_XXXXXXXX-zone-isp_proxy1
BRD_PASS=
TARGET_HOST=brd.superproxy.io
TARGET_PORT=44445

# ---- front hop: the address the zone sees. Leave empty if the VM itself
#      already sits in an allowed country (VPN/WireGuard on the host). ----
FRONT_HOST=
FRONT_PORT=
FRONT_USER=
FRONT_PASS=

# ---- relay side: credentials your client presents to socks5://<host>:1080 ----
LISTEN_HOST=0.0.0.0
LISTEN_PORT=1080
RELAY_USER=
RELAY_PASS=